#ifndef NEI_BUILD_VERSION_H_
#define NEI_BUILD_VERSION_H_

// Generated from version.h.in by CMake -- do not edit this file directly.
// The single source of truth is the project() VERSION line in the root
// CMakeLists.txt.

#define NEI_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define NEI_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define NEI_VERSION_PATCH @PROJECT_VERSION_PATCH@

// Full version string, e.g. "0.9.0".
#define NEI_VERSION_STRING "@PROJECT_VERSION@"

// Packed integer version for compile-time comparison and conditional
// compilation, e.g. #if NEI_VERSION_HEX >= 0x010000.
#define NEI_VERSION_HEX ((NEI_VERSION_MAJOR << 16) | (NEI_VERSION_MINOR << 8) | NEI_VERSION_PATCH)

#endif // NEI_BUILD_VERSION_H_
