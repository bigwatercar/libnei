if(NOT NEI_COMPILER_DETECTED)
  message(STATUS "CMAKE_C_COMPILER_ID: ${CMAKE_C_COMPILER_ID}")
  message(STATUS "CMAKE_C_COMPILER_FRONTEND_VARIANT: ${CMAKE_C_COMPILER_FRONTEND_VARIANT}")
  message(STATUS "CMAKE_CXX_COMPILER_ID: ${CMAKE_CXX_COMPILER_ID}")
  message(STATUS "CMAKE_CXX_COMPILER_FRONTEND_VARIANT: ${CMAKE_CXX_COMPILER_FRONTEND_VARIANT}")

  if(NOT CMAKE_C_COMPILER_ID OR NOT CMAKE_CXX_COMPILER_ID)
    message(FATAL_ERROR "C and C++ compilers must be specified")
  endif()
  if(NOT CMAKE_C_COMPILER_ID STREQUAL CMAKE_CXX_COMPILER_ID)
    message(FATAL_ERROR "C and C++ compilers must be of the same type")
  endif()

  # check compiler is msvc or clang-cl
  if(CMAKE_C_COMPILER_ID STREQUAL "MSVC" AND CMAKE_C_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
    set(NEI_COMPILER_IS_MSVC TRUE)
  endif()
  if(CMAKE_C_COMPILER_ID STREQUAL "Clang" AND CMAKE_C_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
    set(NEI_COMPILER_IS_MSVC TRUE)
    set(NEI_COMPILER_IS_CLANG_CL TRUE)
  endif()

  # check compiler is gnu or clang-gnu
  if(CMAKE_C_COMPILER_ID STREQUAL "GNU" AND CMAKE_C_COMPILER_FRONTEND_VARIANT STREQUAL "GNU")
    set(NEI_COMPILER_IS_GNU TRUE)
  endif()
  if(CMAKE_C_COMPILER_ID STREQUAL "Clang" AND CMAKE_C_COMPILER_FRONTEND_VARIANT STREQUAL "GNU")
    set(NEI_COMPILER_IS_GNU TRUE)
    set(NEI_COMPILER_IS_CLANG_GNU TRUE)
  endif()

  # check compiler is apple-clang
  if(CMAKE_C_COMPILER_ID STREQUAL "AppleClang" AND CMAKE_C_COMPILER_FRONTEND_VARIANT STREQUAL "AppleClang")
    set(NEI_COMPILER_IS_APPLE_CLANG TRUE)
  endif()

  set(NEI_MSVC_FLAVOR ${NEI_COMPILER_IS_MSVC})
  set(NEI_GNU_FLAVOR ${NEI_COMPILER_IS_GNU})
  set(NEI_APPLE_CLANG_FLAVOR ${NEI_COMPILER_IS_APPLE_CLANG})

  if(NEI_MSVC_FLAVOR)
    message(STATUS "Compiler is MSVC flavor")
  elseif(NEI_GNU_FLAVOR)
    message(STATUS "Compiler is GNU flavor")
  elseif(NEI_APPLE_CLANG_FLAVOR)
    message(STATUS "Compiler is Apple Clang flavor")
  else()
    message(FATAL_ERROR "Unknown compiler flavor")
  endif()
  set(NEI_COMPILER_DETECTED TRUE)
endif(NOT NEI_COMPILER_DETECTED)
